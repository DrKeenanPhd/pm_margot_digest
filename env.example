# Copy these into Railway → Variables. Do NOT commit a real .env file.
GHL_PIT=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GHL_LOCATION_ID=your_subaccount_location_id
DIGEST_TZ=America/Los_Angeles
AGENT_ID=6a0e385e321d30067d28477a
# DATA_DIR: where "mark handled" state is stored. Mount a Railway Volume
# here for persistence across redeploys (e.g. /data). Defaults to ./data.
DATA_DIR=/data
